// ── Metrics ──────────────────────────────────────────  

prometheus.scrape "api" {  
  targets = [{  
    __address__ = "api:8080",  
    service     = "api",  
    project     = "city-explorer",  
  }]  
  scrape_interval = "15s"  
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]  
}  

prometheus.scrape "collector" {  
  targets = [{  
    __address__ = "collector:8081",  
    service     = "collector",  
    project     = "city-explorer",  
  }]  
  scrape_interval = "15s"  
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]  
}  

prometheus.remote_write "grafana_cloud" {  
  endpoint {  
    url = env("GRAFANA_PROMETHEUS_URL")  
    basic_auth {  
      username = env("GRAFANA_PROMETHEUS_USERNAME")  
      password = env("GRAFANA_API_KEY")  
    }  
  }  
}  

// ── Logs ─────────────────────────────────────────────  

discovery.docker "containers" {  
  host             = "unix:///var/run/docker.sock"  
  refresh_interval = "5s"  
  filter {  
    name   = "name"  
    values = ["city-explorer-api", "city-explorer-collector"]  
  }  
}  

discovery.relabel "containers" {  
  targets = discovery.docker.containers.targets  

  rule {  
    source_labels = ["__meta_docker_container_name"]  
    regex         = "/(.+)"  
    target_label  = "container"  
  }  
  rule {  
    source_labels = ["__meta_docker_container_name"]  
    regex         = "/city-explorer-(.+)"  
    target_label  = "service"  
  }  
  rule {  
    target_label = "project"  
    replacement  = "city-explorer"  
  }  
}  

loki.source.docker "containers" {  
  host       = "unix:///var/run/docker.sock"  
  targets    = discovery.relabel.containers.output  
  forward_to = [loki.write.grafana_cloud.receiver]  
}  

loki.write "grafana_cloud" {  
  endpoint {  
    url = env("GRAFANA_LOKI_URL")  
    basic_auth {  
      username = env("GRAFANA_LOKI_USERNAME")  
      password = env("GRAFANA_API_KEY")  
    }  
  }  
}  

// ── Traces ───────────────────────────────────────────

// Receive traces from your services via OTLP HTTP
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

// Forward traces to Grafana Cloud Tempo
otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = env("GRAFANA_TEMPO_URL")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = env("GRAFANA_TEMPO_USERNAME")
  password = env("GRAFANA_API_KEY")
}

// ── Database Observability ────────────────────────────

// FIX 5: removed space in path
// local.file "postgres_secret_city_explorer_db" {
//   filename  = "/var/lib/alloy/postgres_secret_city_explorer_db"
//   is_secret = true
// }

// FIX 3: single exporter (removed duplicate city_explorer_db)
// FIX 1: data_source_names uncommented — required
prometheus.exporter.postgres "postgres_city_explorer_db" {
  data_source_names  = [env("POSTGRES_MONITOR_DSN")]
  enabled_collectors = ["stat_statements"]

  stat_statements {
    exclude_users = ["db-o11y"]
  }

  autodiscovery {
    enabled = true
    // database_denylist = ["rdsadmin"]
  }
}

// FIX 2: data_source_name uncommented — required
database_observability.postgres "postgres_city_explorer_db" {
  data_source_name  = env("POSTGRES_MONITOR_DSN")  
  forward_to        = [loki.relabel.database_observability_postgres_city_explorer_db.receiver]
  targets           = prometheus.exporter.postgres.postgres_city_explorer_db.targets
  enable_collectors = ["query_details", "query_samples", "schema_details", "explain_plans"]
  exclude_users     = ["db-o11y"]
  // exclude_databases = ["rdsadmin"]
}

// FIX 4: added required job label for DB o11y dashboards
loki.relabel "database_observability_postgres_city_explorer_db" {
  forward_to = [loki.write.grafana_cloud.receiver]

  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement  = "postgres_city_explorer_db"
  }
}

discovery.relabel "database_observability_postgres_city_explorer_db" {
  targets = database_observability.postgres.postgres_city_explorer_db.targets

  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }
}

prometheus.scrape "database_observability_postgres_city_explorer_db" {
  targets    = discovery.relabel.database_observability_postgres_city_explorer_db.output
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}